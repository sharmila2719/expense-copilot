# ============================================================
# Expense Copilot — Environment configuration
# Copy this file to ".env" and adjust as needed.
# ============================================================

# LLM provider: "local" (free, no keys, runs offline) or "bedrock" (Amazon Bedrock)
LLM_PROVIDER=local

# ---- Amazon Bedrock settings (only used when LLM_PROVIDER=bedrock) ----
AWS_REGION=us-east-1
# Text / reasoning + vision model (Anthropic Claude on Bedrock)
BEDROCK_TEXT_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
# Embedding model on Bedrock
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Credentials are read from the standard AWS chain:
#   environment vars, ~/.aws/credentials, IAM role, etc.
# Optionally set them explicitly here:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- App settings ----
DATA_DIR=./data
BACKEND_URL=http://localhost:8000
